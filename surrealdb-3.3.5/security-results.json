  "interpretation": {
    "scope": "Isolated fixture only. Signin by name is intentional test instrumentation, not production authentication guidance.",
    "rollback": "Observed v3.3.5 behavior: HTTP API and api::invoke convert THROW to response 500 and preceding writes persist. Direct function call fails transaction and rolls back. Explicit outer CANCEL rolls back api::invoke writes. This is an observed semantics mismatch with required atomic API failure, not a claim of a confirmed upstream bug.",
    "anonymous": "Server rejects anonymous SQL before evaluation; HTTP custom API auth gate independently refuses anonymous callers.",
    "http_api_path": "/api/:namespace/security/notes/:id"
  },
  "sources": [
    {
      "url": "https://github.com/surrealdb/surrealdb/blob/v3.3.5/surrealdb/core/src/api/invocation.rs#L183-L195",
      "snippet": "183: \t// APIs run without permissions & limit auth\n184: \tlet opt = opt.limited_by(&AuthLimit::try_from(&api.auth_limit)?);\n185: \tlet opt = opt.new_with_perms(false);\n186: \n187: \tdebug!(\n188: \t\trequest_id = %req.request_id,\n189: \t\tmiddleware_count = middleware.len(),\n190: \t\t\"Executing API middleware chain\"\n191: \t);\n192: \tlet mut res: ApiResponse =\n193: \t\tcrate::legacy::closure_invoke(&next, stk, ctx, &opt, None, vec![req.into()])\n194: \t\t\t.await?\n195: \t\t\t.try_into()?;"
    },
    {
      "url": "https://github.com/surrealdb/surrealdb/blob/v3.3.5/surrealdb/core/src/api/invocation.rs#L232-L262",
      "snippet": "232: \t\t\t\t\tX_SURREAL_REQUEST_ID,\n233: \t\t\t\t\tHeaderValue::from_str(&request_id)\n234: \t\t\t\t\t\t.unwrap_or_else(|_| HeaderValue::from_static(\"unknown\")),\n235: \t\t\t\t);\n236: \t\t\t}\n237: \n238: \t\t\t// Update context\n239: \t\t\tlet mut ctx_isolated = Context::new_isolated(ctx);\n240: \t\t\tctx_isolated.add_value(\"request\", Arc::new(req.into()));\n241: \t\t\tlet ctx_frozen = ctx_isolated.freeze();\n242: \n243: \t\t\t// Clone required values\n244: \t\t\tlet action_expr = action_expr.clone();\n245: \t\t\tlet request_id = request_id.clone();\n246: \t\t\t// Execute\n247: \t\t\tBox::pin(stk.run(async move |stk| {\n248: \t\t\t\t// Computed result\n249: \t\t\t\tlet res = crate::legacy::expr_compute(&action_expr, stk, &ctx_frozen, opt, doc)\n250: \t\t\t\t\t.await\n251: \t\t\t\t\t.catch_return();\n252: \n253: \t\t\t\t// Convert to ApiResponse; set request_id from request for all responses\n254: \t\t\t\tlet mut res = match res {\n255: \t\t\t\t\tOk(res) => ApiResponse::try_from(res)\n256: \t\t\t\t\t\t.unwrap_or_else(|e| ApiResponse::from_error(e, request_id.clone())),\n257: \t\t\t\t\tErr(e) => ApiResponse::from_error(e, request_id.clone()),\n258: \t\t\t\t};\n259: \t\t\t\tres.request_id.clone_from(&request_id);\n260: \t\t\t\tres.ensure_request_id_header();\n261: \n262: \t\t\t\tOk(Value::from(res))"
    },
    {
      "url": "https://github.com/surrealdb/surrealdb/blob/v3.3.5/surrealdb/core/src/legacy/expr/function.rs#L55-L91",
      "snippet": "55: \t\t\t// Get the function definition\n56: \t\t\tlet (ns, db) = ctx.expect_ns_db_ids(opt).await?;\n57: \t\t\tlet val = ctx.tx().get_db_function(ns, db, s, opt.version).await?;\n58: \t\t\tlet opt = opt.limited_by(&AuthLimit::try_from(&val.auth_limit)?);\n59: \n60: \t\t\t// Check permissions\n61: \t\t\tif ctx.check_perms(&opt, Action::View)? {\n62: \t\t\t\tcheck_perms(stk, ctx, &opt, doc, &name, &val.permissions).await?;\n63: \t\t\t}\n64: \t\t\t// Validate the arguments\n65: \t\t\tvalidate_args(\n66: \t\t\t\t&name,\n67: \t\t\t\t&args,\n68: \t\t\t\t&val.args.iter().map(|(_, k)| k.clone()).collect::<Vec<Kind>>(),\n69: \t\t\t)?;\n70: \t\t\t// Compute the function arguments\n71: \t\t\t// Duplicate context\n72: \t\t\tlet mut ctx = Context::new_isolated(ctx);\n73: \t\t\t// Process the function arguments\n74: \t\t\tfor (val, (param_name, kind)) in args.into_iter().zip(&val.args) {\n75: \t\t\t\tctx.add_value(\n76: \t\t\t\t\tparam_name.clone(),\n77: \t\t\t\t\tval.coerce_to_kind(kind)\n78: \t\t\t\t\t\t.map_err(|e| ExprError::InvalidFunctionArguments {\n79: \t\t\t\t\t\t\tname: name.clone(),\n80: \t\t\t\t\t\t\tmessage: format!(\"Failed to coerce argument `${param_name}`: {e}\"),\n81: \t\t\t\t\t\t})\n82: \t\t\t\t\t\t.map_err(anyhow::Error::new)?\n83: \t\t\t\t\t\t.into(),\n84: \t\t\t\t);\n85: \t\t\t}\n86: \t\t\tlet ctx = ctx.freeze();\n87: \t\t\t// Run the custom function\n88: \t\t\tlet result = stk\n89: \t\t\t\t.run(|stk| crate::legacy::block_compute(&val.block, stk, &ctx, &opt, doc))\n90: \t\t\t\t.await\n91: \t\t\t\t.catch_return()?;"
